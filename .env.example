# ==============================================================================
# AUTOMATION HUB - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env.local or set these variables in your
# hosting platform dashboard (e.g., Vercel, Supabase, AWS, Cloudflare).
# NEVER commit .env, .env.local, API keys, database passwords, or secrets to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://automation-testing-theta.vercel.app
NEXT_PUBLIC_SITE_NAME="Automation Hub"

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE, AUTH & STORAGE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Public Supabase project URL and anon public key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-ONLY: NEVER EXPOSE TO CLIENT/NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Storage Bucket Names
SUPABASE_MEDIA_BUCKET=media

# ------------------------------------------------------------------------------
# 3. ENCRYPTION & SECURITY KEYS (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte hex-encoded encryption key for encrypting OAuth tokens in database
# Generate via: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret for securing internal cron jobs and worker endpoints
CRON_SECRET=your-secure-random-cron-secret-key-32-chars

# ------------------------------------------------------------------------------
# 4. OFFICIAL PLATFORM OAUTH CREDENTIALS & REDIRECT URI
# ------------------------------------------------------------------------------
# Meta / Instagram Graph API Configuration
# App Dashboard: https://developers.facebook.com/apps
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_OAUTH_REDIRECT_URI=https://automation-testing-theta.vercel.app/api/oauth/instagram/callback

# Pinterest API v5 Configuration
# Developer Portal: https://developers.pinterest.com/apps
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_OAUTH_REDIRECT_URI=https://automation-testing-theta.vercel.app/api/oauth/pinterest/callback

# Medium Integration & API v1
# Applications: https://medium.com/me/applications
MEDIUM_CLIENT_ID=your_medium_client_id
MEDIUM_CLIENT_SECRET=your_medium_client_secret
MEDIUM_OAUTH_REDIRECT_URI=https://automation-testing-theta.vercel.app/api/oauth/medium/callback

# ------------------------------------------------------------------------------
# 5. AI PROVIDER (MULTIMODAL POSTER ANALYSIS & COPY GENERATION)
# ------------------------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere...
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere...

# ------------------------------------------------------------------------------
# 6. QUEUE & SCHEDULER INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Upstash Redis / Redis URL for background job queueing
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
REDIS_URL=rediss://default:your-password@your-redis-host:6379

# Queue Worker Concurrency & Timeout
WORKER_CONCURRENCY=5
JOB_TIMEOUT_SECONDS=60
MAX_JOB_RETRIES=4

# ------------------------------------------------------------------------------
# 7. MONITORING, TELEMETRY & LOGGING
# ------------------------------------------------------------------------------
# Sentry / Datadog Error Tracking DSN (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info
